# ---------------------------------------------------------------
# Unity: generated folders (regenerated when the project opens)
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Keep .meta files for every asset that is tracked
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / solution files (Unity regenerates these)
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Packed Addressables / temporary Android assets
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# Build output (the iOS Xcode project alone is over 1 GB)
# ---------------------------------------------------------------
/[Bb]uild/
/[Bb]uilds/
*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.ipa
*.app
*.xcarchive
*.dSYM/
*.unitypackage

# ---------------------------------------------------------------
# Niantic Spatial SDK runtime data
# (auth tokens, logs, device id and a ~9 MB model cache)
# ---------------------------------------------------------------
/data/

# ---------------------------------------------------------------
# Local secrets: never commit API keys
# LassoDrawer reads the Gemini key from Assets/Resources/Secrets/GeminiApiKey.txt
# ---------------------------------------------------------------
/[Aa]ssets/[Rr]esources/[Ss]ecrets/
/[Aa]ssets/[Rr]esources/[Ss]ecrets.meta
.env
.env.*

# ---------------------------------------------------------------
# Modern UI Pack (Michsky) is a paid Unity Asset Store package whose
# license doesn't allow public redistribution. Each developer imports
# it from the Asset Store (see README > Getting started).
# ---------------------------------------------------------------
/[Aa]ssets/Modern UI Pack/
/[Aa]ssets/Modern UI Pack.meta

# ---------------------------------------------------------------
# Large binaries that should not live in git
# Product GLBs are streamed from Backblaze B2 at runtime, so local
# copies stay out of the repo.
# ---------------------------------------------------------------
*.glb
*.mp4
*.mov
*.zip
*.7z
*.tar.gz

# ---------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------
.DS_Store
._*
Thumbs.db
